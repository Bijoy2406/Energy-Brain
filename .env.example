# Copy this file to .env and fill in real values. Never commit .env.

# LLM used by the Explainer agent (#19). Provider: Groq (OpenAI-compatible API, keys at console.groq.com/keys).
# LLM_MODEL: a Groq model that supports tool calling (list the models your key can see).
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=

# Backend URL the React app calls (#27)
API_BASE_URL=http://localhost:8000

# Dashboard API (#21). Run: uvicorn energy_brain.api.app:app --reload --port 8000
# EB_CORS_ORIGINS: extra allowed browser origins, comma-separated (the React dev server on
#   http://localhost:5173 and http://127.0.0.1:5173 is always allowed).
# EB_EXPLAIN_CACHE: stored verified demo answers: fallback (only when the live LLM call fails), prefer (serve
#   them first; for demo day), or off.
# EB_WARMUP: 1 plans the demo days in the background at startup; 0 disables it.
EB_CORS_ORIGINS=
EB_EXPLAIN_CACHE=fallback
EB_WARMUP=1
# Optional: serve a built website from this directory after the API routes.
# Leave empty for API-only mode; for a local production preview use web/dist.
EB_STATIC_DIR=
