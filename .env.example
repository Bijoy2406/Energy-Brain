# Copy this file to .env and fill in real values. Never commit .env.

# LLM used by the Explainer agent (#19). Provider: Groq (OpenAI-compatible API, keys at console.groq.com/keys).
# LLM_MODEL: a Groq model that supports tool calling (list the models your key can see).
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=

# Backend URL the React app calls (#27)
API_BASE_URL=http://localhost:8000
